---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route_question(route_question)
	retrieve(retrieve)
	grade_documents(grade_documents)
	rewrite_query(rewrite_query)
	generate(generate)
	fallback(fallback)
	contextualize_question(contextualize_question)
	record_turn(record_turn)
	__end__([<p>__end__</p>]):::last
	__start__ --> contextualize_question;
	contextualize_question --> route_question;
	fallback --> record_turn;
	generate --> record_turn;
	grade_documents -.-> fallback;
	grade_documents -.-> generate;
	grade_documents -.-> rewrite_query;
	retrieve --> grade_documents;
	rewrite_query --> retrieve;
	route_question -.-> fallback;
	route_question -.-> retrieve;
	record_turn --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
